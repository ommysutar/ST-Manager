{
  "name": "@st-manager/theme",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens and themes shared across ST Manager UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/tokens.css": "./src/css/tokens.css"
  },
  "scripts": {
    "build": "tsx scripts/generate-css.ts && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
