// PostgreSQL schema — primary/production datasource for @st-manager/database.
// Consumed by apps/api (per ADR 0001: desktop is online-only through M7 and
// does not touch this schema directly). See
// docs/meeting-notes/M2-planning-report.md for the dual-provider rationale.
//
// Learn more about the Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/postgresql"
}

datasource db {
  provider = "postgresql"
}

model Studio {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(120)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  sessions  Session[]

  @@map("studios")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         String   @default("owner") @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Client {
  id                  String    @id @default(cuid())
  name                String    @db.VarChar(120)
  email               String?   @db.VarChar(255)
  phone               String?   @db.VarChar(64)
  whatsappNumber      String?   @db.VarChar(64)
  whatsappSameAsPhone Boolean   @default(false)
  company             String?   @db.VarChar(64)
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  bookings            Booking[]
  sessions            Session[]
  invoices            Invoice[]

  @@map("clients")
}

model Booking {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  title     String    @db.VarChar(120)
  startAt   DateTime
  endAt     DateTime
  status    String    @default("confirmed") @db.VarChar(32)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  session Session?

  @@index([studioId, startAt, endAt])
  @@map("bookings")
}

model Session {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  bookingId String?   @unique
  title     String    @db.VarChar(120)
  startedAt DateTime
  endedAt   DateTime?
  status    String    @default("scheduled") @db.VarChar(32)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  invoice Invoice?

  @@index([studioId, status, startedAt])
  @@map("sessions")
}

model Invoice {
  id        String    @id @default(cuid())
  clientId  String
  sessionId String?   @unique
  number    String    @unique @db.VarChar(32)
  status    String    @default("draft") @db.VarChar(32)
  lineItems Json
  subtotal  Float
  taxRate   Float     @default(0)
  tax       Float
  total     Float
  dueDate   DateTime
  issuedAt  DateTime?
  paidAt    DateTime?
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([clientId, status])
  @@index([status, paidAt])
  @@map("invoices")
}
