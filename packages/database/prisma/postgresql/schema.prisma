// PostgreSQL schema — primary/production datasource for @st-manager/database.
// Consumed by apps/api (per ADR 0001: desktop is online-only through M7 and
// does not touch this schema directly). See
// docs/meeting-notes/M2-planning-report.md for the dual-provider rationale.
//
// Learn more about the Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/postgresql"
}

datasource db {
  provider = "postgresql"
}

model Studio {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(120)
  status          String              @default("active") @db.VarChar(32)
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  bookings        Booking[]
  sessions        Session[]
  members         User[]
  invitations     StudioInvitation[]
  auditLogs       AuditLog[]
  roleDefs        RoleDefinition[]
  activationCodes ActivationCode[]
  clientPortalLinks ClientPortalLink[]

  @@index([status])
  @@map("studios")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique @db.VarChar(255)
  passwordHash       String              @db.VarChar(255)
  fullName           String?             @db.VarChar(120)
  phone              String?             @db.VarChar(64)
  role               String              @default("owner") @db.VarChar(32)
  status             String              @default("active") @db.VarChar(32)
  studioId           String?
  customPermissions  Json?
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studio             Studio?             @relation(fields: [studioId], references: [id])
  sentInvitations    StudioInvitation[]  @relation("InvitationSender")
  auditLogs          AuditLog[]          @relation("AuditActor")

  @@index([studioId])
  @@map("users")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(64)
  label       String           @db.VarChar(120)
  category    String           @db.VarChar(64)
  createdAt   DateTime         @default(now())
  rolePerms   RolePermission[]

  @@map("permissions")
}

model RoleDefinition {
  id          String           @id @default(cuid())
  studioId    String?
  name        String           @db.VarChar(32)
  label       String           @db.VarChar(64)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  studio      Studio?          @relation(fields: [studioId], references: [id])
  permissions RolePermission[]

  @@unique([studioId, name])
  @@map("role_definitions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StudioInvitation {
  id                String    @id @default(cuid())
  studioId          String
  email             String    @db.VarChar(255)
  fullName          String    @db.VarChar(120)
  phone             String?   @db.VarChar(64)
  role              String    @db.VarChar(32)
  tokenHash         String    @unique @db.VarChar(64)
  status            String    @default("pending") @db.VarChar(32)
  customPermissions Json?
  expiresAt         DateTime
  invitedById       String
  acceptedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  studio            Studio    @relation(fields: [studioId], references: [id])
  invitedBy         User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([studioId, status])
  @@index([email])
  @@map("studio_invitations")
}

model AuditLog {
  id          String   @id @default(cuid())
  studioId    String
  actorUserId String?
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(32)
  targetId    String?  @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now())
  studio      Studio   @relation(fields: [studioId], references: [id])
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([studioId, createdAt])
  @@map("audit_logs")
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String   @db.VarChar(255)
  action      String   @db.VarChar(64)
  studioId    String?
  studioName  String?  @db.VarChar(120)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([studioId])
  @@map("platform_audit_logs")
}

model ActivationCode {
  id                       String    @id @default(cuid())
  code                     String    @unique @db.VarChar(32)
  status                   String    @default("ACTIVE") @db.VarChar(32)
  createdAt                DateTime  @default(now())
  expiresAt                DateTime?
  usedAt                   DateTime?
  usedByStudioId           String?
  usedByOwnerEmail         String?   @db.VarChar(255)
  generatedByPlatformAdmin String    @db.VarChar(64)
  notes                    String?   @db.Text
  licenseType              String    @default("LIFETIME") @db.VarChar(32)
  subscriptionMonths       Int?
  customerName             String?   @db.VarChar(120)
  phone                    String?   @db.VarChar(64)
  activatedAt              DateTime?
  revokedAt                DateTime?
  usedByStudio             Studio?   @relation(fields: [usedByStudioId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([licenseType])
  @@map("activation_codes")
}

model Client {
  id                  String    @id @default(cuid())
  name                String    @db.VarChar(120)
  email               String?   @db.VarChar(255)
  phone               String?   @db.VarChar(64)
  whatsappNumber      String?   @db.VarChar(64)
  whatsappSameAsPhone Boolean   @default(false)
  company             String?   @db.VarChar(64)
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  bookings            Booking[]
  sessions            Session[]
  invoices            Invoice[]

  @@map("clients")
}

model Booking {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  title     String    @db.VarChar(120)
  startAt   DateTime
  endAt     DateTime
  status    String    @default("confirmed") @db.VarChar(32)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  session Session?

  @@index([studioId, startAt, endAt])
  @@map("bookings")
}

model Session {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  bookingId String?   @unique
  title     String    @db.VarChar(120)
  startedAt DateTime
  endedAt   DateTime?
  status    String    @default("scheduled") @db.VarChar(32)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  invoice Invoice?

  @@index([studioId, status, startedAt])
  @@map("sessions")
}

model Invoice {
  id        String    @id @default(cuid())
  clientId  String
  sessionId String?   @unique
  number    String    @unique @db.VarChar(32)
  status    String    @default("draft") @db.VarChar(32)
  lineItems Json
  subtotal  Float
  taxRate   Float     @default(0)
  tax       Float
  total     Float
  dueDate   DateTime
  issuedAt  DateTime?
  paidAt    DateTime?
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([clientId, status])
  @@index([status, paidAt])
  @@map("invoices")
}

model ClientPortalLink {
  id          String    @id @default(cuid())
  studioId    String
  projectKey  String    @db.VarChar(64)
  tokenHash   String    @unique @db.VarChar(64)
  status      String    @default("active") @db.VarChar(32)
  expiresAt   DateTime?
  completedAt DateTime?
  snapshot    Json
  studioMessage String? @db.Text
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, projectKey])
  @@index([studioId, status])
  @@map("client_portal_links")
}
