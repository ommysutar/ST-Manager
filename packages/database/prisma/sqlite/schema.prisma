// SQLite schema — local-development / future-desktop preparation datasource.
// M11: field shapes mirrored in apps/desktop/src-tauri/src/db/migrations.rs
// (Rust rusqlite — not Prisma in the desktop process). See ADR 0001.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

model Studio {
  id              String              @id @default(cuid())
  name            String
  status          String              @default("active")
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  bookings        Booking[]
  sessions        Session[]
  members         User[]
  invitations     StudioInvitation[]
  auditLogs       AuditLog[]
  roleDefs        RoleDefinition[]
  activationCodes ActivationCode[]
  clientPortalLinks ClientPortalLink[]

  @@index([status])
  @@map("studios")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  fullName           String?
  phone              String?
  role               String              @default("owner")
  status             String              @default("active")
  studioId           String?
  customPermissions  Json?
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studio             Studio?             @relation(fields: [studioId], references: [id])
  sentInvitations    StudioInvitation[]  @relation("InvitationSender")
  auditLogs          AuditLog[]          @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]

  @@index([studioId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model PasswordResetRateLimit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("password_reset_rate_limits")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  category    String
  createdAt   DateTime         @default(now())
  rolePerms   RolePermission[]

  @@map("permissions")
}

model RoleDefinition {
  id          String           @id @default(cuid())
  studioId    String?
  name        String
  label       String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  studio      Studio?          @relation(fields: [studioId], references: [id])
  permissions RolePermission[]

  @@unique([studioId, name])
  @@map("role_definitions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StudioInvitation {
  id                String    @id @default(cuid())
  studioId          String
  email             String
  fullName          String
  phone             String?
  role              String
  tokenHash         String    @unique
  status            String    @default("pending")
  customPermissions Json?
  expiresAt         DateTime
  invitedById       String
  acceptedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  studio            Studio    @relation(fields: [studioId], references: [id])
  invitedBy         User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([studioId, status])
  @@index([email])
  @@map("studio_invitations")
}

model AuditLog {
  id          String   @id @default(cuid())
  studioId    String
  actorUserId String?
  action      String
  targetType  String? 
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  studio      Studio   @relation(fields: [studioId], references: [id])
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([studioId, createdAt])
  @@map("audit_logs")
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String
  action      String
  studioId    String?
  studioName  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([studioId])
  @@map("platform_audit_logs")
}

model ActivationCode {
  id                       String    @id @default(cuid())
  code                     String    @unique
  status                   String    @default("ACTIVE")
  createdAt                DateTime  @default(now())
  expiresAt                DateTime?
  usedAt                   DateTime?
  usedByStudioId           String?
  usedByOwnerEmail         String?
  generatedByPlatformAdmin String
  notes                    String?
  licenseType              String    @default("LIFETIME")
  subscriptionMonths       Int?
  customerName             String?
  phone                    String?
  activatedAt              DateTime?
  revokedAt                DateTime?
  usedByStudio             Studio?   @relation(fields: [usedByStudioId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([licenseType])
  @@map("activation_codes")
}

model Client {
  id                  String    @id @default(cuid())
  name                String
  email               String?
  phone               String?
  whatsappNumber      String?
  whatsappSameAsPhone Boolean   @default(false)
  company             String?
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  bookings            Booking[]
  sessions            Session[]
  invoices            Invoice[]

  @@map("clients")
}

model Booking {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  title     String
  startAt   DateTime
  endAt     DateTime
  status    String    @default("confirmed")
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  session Session?

  @@index([studioId, startAt, endAt])
  @@map("bookings")
}

model Session {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  bookingId String?   @unique
  title     String
  startedAt DateTime
  endedAt   DateTime?
  status    String    @default("scheduled")
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  invoice Invoice?

  @@index([studioId, status, startedAt])
  @@map("sessions")
}

model Invoice {
  id        String    @id @default(cuid())
  clientId  String
  sessionId String?   @unique
  number    String    @unique
  status    String    @default("draft")
  lineItems Json
  subtotal  Float
  taxRate   Float     @default(0)
  tax       Float
  total     Float
  dueDate   DateTime
  issuedAt  DateTime?
  paidAt    DateTime?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([clientId, status])
  @@index([status, paidAt])
  @@map("invoices")
}

model ClientPortalLink {
  id            String    @id @default(cuid())
  studioId      String
  projectKey    String
  tokenHash     String    @unique
  status        String    @default("active")
  expiresAt     DateTime?
  completedAt   DateTime?
  snapshot      Json
  studioMessage String?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  studio        Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, projectKey])
  @@index([studioId, status])
  @@map("client_portal_links")
}
