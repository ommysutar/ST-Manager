// SQLite schema — local-development / future-desktop preparation datasource.
// M11: field shapes mirrored in apps/desktop/src-tauri/src/db/migrations.rs
// (Rust rusqlite — not Prisma in the desktop process). See ADR 0001.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

model Studio {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  sessions  Session[]

  @@map("studios")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  sessions  Session[]
  invoices  Invoice[]

  @@map("clients")
}

model Booking {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  title     String
  startAt   DateTime
  endAt     DateTime
  status    String    @default("confirmed")
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  session Session?

  @@index([studioId, startAt, endAt])
  @@map("bookings")
}

model Session {
  id        String    @id @default(cuid())
  studioId  String
  clientId  String?
  bookingId String?   @unique
  title     String
  startedAt DateTime
  endedAt   DateTime?
  status    String    @default("scheduled")
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studio  Studio   @relation(fields: [studioId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  invoice Invoice?

  @@index([studioId, status, startedAt])
  @@map("sessions")
}

model Invoice {
  id        String    @id @default(cuid())
  clientId  String
  sessionId String?   @unique
  number    String    @unique
  status    String    @default("draft")
  lineItems Json
  subtotal  Float
  taxRate   Float     @default(0)
  tax       Float
  total     Float
  dueDate   DateTime
  issuedAt  DateTime?
  paidAt    DateTime?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([clientId, status])
  @@index([status, paidAt])
  @@map("invoices")
}
