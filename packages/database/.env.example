# Copy this file to .env and adjust values for local development.
# See docs/meeting-notes/M2-planning-report.md for the dual-provider rationale.

# PostgreSQL — primary/production datasource, consumed by apps/api.
# Requires a reachable PostgreSQL instance (see infra/docker).
DATABASE_URL="postgresql://user:password@localhost:5432/st_manager?schema=public"

# SQLite — local-dev / future-desktop preparation datasource (ADR 0001, M11).
# File-based; no server required.
SQLITE_URL="file:./prisma/sqlite/dev.db"
