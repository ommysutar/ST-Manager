# API base URL for the web client (Next.js exposes only NEXT_PUBLIC_* vars to the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Set to "true" only for developer demo seeding (studios, slots, services, plans).
# Leave unset or "false" for production / fresh-install behavior.
# NEXT_PUBLIC_ENABLE_DEMO_DATA=false
