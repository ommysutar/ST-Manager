# Copy this file to .env and adjust values for local development.
# See docs/meeting-notes/M3-implementation-report.md for the provider
# selection rationale (PostgreSQL = production, SQLite = development/test).

NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:1420

# JWT auth (M10) — use a long random string in real deployments.
AUTH_SECRET="dev-only-auth-secret-minimum-32-characters-long"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL — required when NODE_ENV=production.
DATABASE_URL="postgresql://user:password@localhost:5432/st_manager?schema=public"

# SQLite — required when NODE_ENV is development or test. This value is
# always resolved relative to packages/database (not this app), so it must
# match the value in packages/database/.env.example regardless of where
# apps/api is started from.
SQLITE_URL="file:./prisma/sqlite/dev.db"

# AI (M12) — mock provider works without a key; set openai + key for live summaries.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Email (team invitations) — resend sends real mail; console logs to stdout only.
EMAIL_PROVIDER=resend
# Local dev: http://localhost:3000 — production: https://stmanager.app
APP_BASE_URL=https://stmanager.app
RESEND_API_KEY=
EMAIL_FROM=noreply@stmanager.app
