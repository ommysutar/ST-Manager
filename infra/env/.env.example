# Placeholder environment variable names only. No secrets or real values.

# Database (see packages/database/.env.example for the authoritative template)
DATABASE_URL=postgresql://user:password@localhost:5432/st_manager?schema=public
SQLITE_URL=file:./prisma/sqlite/dev.db

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:1420

# Auth (M10 — custom JWT)
AUTH_SECRET="dev-only-auth-secret-minimum-32-characters-long"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_PROVIDER=custom-jwt

# Storage
STORAGE_DRIVER=

# AI
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
